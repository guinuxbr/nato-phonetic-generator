# Operating System generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Dependency directories
# Even though you are using CDNs now, it's good practice to have this
# in case you add a package manager later.
node_modules/
bower_components/

# Build output
dist/
build/
.out/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local

# VSCode
.vscode
.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json

# Other IDEs/Editors
.idea/
*.sublime-project
*.sublime-workspace
